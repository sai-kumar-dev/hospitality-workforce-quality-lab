# Local development only. Copy to .env and replace the demonstration values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://shiftbridge:shiftbridge_dev_only@db:5432/shiftbridge
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=30
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false
LOG_LEVEL=INFO

# QA framework
APP_BASE_URL=http://localhost:4173
API_BASE_URL=http://localhost:8000
TEST_ENV=local
DEFAULT_TIMEOUT_MS=10000
EXPECT_TIMEOUT_MS=5000
TEST_USER_PASSWORD=ShiftBridge-Demo-2026!
ARTIFACTS_DIR=artifacts
HEADLESS=true
WORKER_ID=local
PERFORMANCE_USERS=5
PERFORMANCE_DURATION=30s

# Demo seed credentials (fictional local data)
DEMO_CANDIDATE_EMAIL=candidate@shiftbridge.test
DEMO_EMPLOYER_A_EMAIL=employer.a@shiftbridge.test
DEMO_EMPLOYER_B_EMAIL=employer.b@shiftbridge.test
DEMO_PASSWORD=ShiftBridge-Demo-2026!

